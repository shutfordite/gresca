{
  "name": "gresca",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.8"
  },
  "description": "A fan-made freestyle ski and snowboard game for the browser, with tests that run the real game scripts in Node",
  "scripts": {
    "test": "node --test --test-reporter=dot test/*.test.js",
    "test:verbose": "node --test test/*.test.js",
    "test:rotated": "GRESCA_MAP_ROTATION_DEG=37 node --test --test-reporter=dot test/*.test.js && GRESCA_MAP_ROTATION_DEG=300 node --test --test-reporter=dot test/*.test.js",
    "shot": "node tools/shot.mjs",
    "bench": "node tools/bench/run.mjs",
    "review": "node tools/review/run.mjs",
    "smoke": "node tools/review/smoke.mjs",
    "smoke:gl": "node tools/gl-smoke.mjs",
    "test:sim": "node tools/test-area.mjs sim",
    "test:view": "node tools/test-area.mjs view",
    "test:input": "node tools/test-area.mjs input",
    "test:ui": "node tools/test-area.mjs ui",
    "test:world": "node tools/test-area.mjs world",
    "test:shared": "node tools/test-area.mjs shared",
    "test:tools": "node tools/test-area.mjs tools"
  },
  "devDependencies": {
    "playwright-core": "1.65.1"
  }
}
